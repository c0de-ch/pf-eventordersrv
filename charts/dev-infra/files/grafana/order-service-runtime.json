      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          },
          "expr": "histogram_quantile(0.5, sum by (le, uri) (rate(http_server_requests_seconds_bucket{service_name=\"order-service\",uri=~\"/orders.*\"}[$__rate_interval])))",
          "legendFormat": "p50 {{uri}}",
          "refId": "A"

      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prometheus}"
          },
          "expr": "sum(rate(logback_events_total{service_name=\"order-service\",level=\"error\"}[$__rate_interval])) * 60 or vector(0)",
          "refId": "A",
          "instant": false

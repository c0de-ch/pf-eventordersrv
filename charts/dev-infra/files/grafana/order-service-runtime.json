            "type": "prometheus",
            "uid": "${ds_prometheus}"
          },
          "expr": "histogram_quantile(0.99, sum by (le, uri) (rate(http_server_requests_seconds_bucket{service_name=\"order-service\",uri=~\"/orders.*\"}[$__rate_interval])))",
          "legendFormat": "p99 {{uri}}",

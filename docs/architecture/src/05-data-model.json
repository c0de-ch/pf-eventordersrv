      "style": "dashed",
      "arrow": "none"
    },
    {
      "from": "relaycols",
      "to": "outbox",
      "style": "dashed",
      "arrow": "none"
    },
    {
      "from": "pendingidx",
      "to": "outbox",
      "style": "dashed",
      "arrow": "none"
    },
    {
      "from": "ordersidx",
      "to": "orders",
      "style": "dashed",
      "arrow": "none"
    },
    {
      "from": "checks",
      "to": "orders",
      "style": "dashed",
      "arrow": "none"
    }
  ],
  "paper": {
    "style": "clean",
    "texture": "plain",
    "pencil": "2B",
    "eraserMarks": true,
